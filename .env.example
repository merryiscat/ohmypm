# ohmyPM 환경 변수 — 이 파일을 .env 로 복사해 채운다 (.env는 커밋 금지)
# .env가 없으면 첫 스캔 때 저장소 위치 기준 기본값으로 자동 생성된다. 모르는 변수는 무시된다.

# 관리 대상 루트 — 이 폴더 바로 아래 프로젝트들을 돌본다. PC마다 다르다 (예: D:\dev\project).
PROJECTS_ROOT=

# Claude Code 실행 파일 (헤드리스 호출용). PATH에 있으면 claude
CC_BIN=claude

# 작업 등급별 모델 — 모든 헤드리스 호출은 작업 이름→등급(src/cc/models.py)을 거쳐 --model을 명시한다.
MODEL_LIGHT=haiku
MODEL_STANDARD=sonnet
MODEL_HEAVY=opus
# Fable·Mythos 같은 최상위 모델을 헤드리스에서 쓰려면 명시적으로 켠다(기본 false → heavy로 내림)
ALLOW_FRONTIER_HEADLESS=false

# 모델 연구원이 추적하는 모델(공식 문서 표기 그대로, 쉼표 구분). 목록 밖 모델은 위키에 넣지 않는다.
MODEL_TRACK_CLAUDE=Claude Fable 5.1,Claude Opus 5.5,Claude Opus 5,Claude Sonnet 5,Claude Haiku 4.5
MODEL_TRACK_CODEX=GPT-6 Astra,GPT-6 Sol,GPT-6 Luna

# 게시판 토론 — 동시에 띄우는 담당 수(3이면 이 PC 메모리가 못 버틴 이력), 토론 시간 상한(분)
BOARD_CONCURRENCY=2
BOARD_MAX_MINUTES=60

# 정시 배치 — 남은 정시 배치는 랩실 정기 조사(주 1회)뿐. 0=월요일 … 6=일요일
SCHEDULER_ENABLED=true
EXPERT_COLLECT_WEEKDAY=0
EXPERT_COLLECT_HOUR=5

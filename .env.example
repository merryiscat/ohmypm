# ohmyPM 환경 변수 — 이 파일을 .env 로 복사해 채운다 (.env는 커밋 금지)

# 텔레그램 (비우면 알림은 조용히 건너뜀 — 시스템은 정상 동작)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 관리 대상 루트 — 이 폴더 하위 프로젝트들을 돌본다
PROJECTS_ROOT=C:\Users\minhy\project

# Claude Code 실행 파일 (headless 호출용). PATH에 있으면 claude
CC_BIN=claude

# 정시 스캔 시각(24시간, 예 8 = 08:00) / heartbeat 감지 주기(초)
SCAN_HOUR=8
HEARTBEAT_SEC=300

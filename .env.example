# ohmyPM 환경 변수 — 이 파일을 .env 로 복사해 채운다 (.env는 커밋 금지)

# 관리 대상 루트 — 이 폴더 하위 프로젝트들을 돌본다.
# **PC마다 다르다.** 이 PC의 실제 경로를 넣는다 (예: D:\dev\project). 필수.
PROJECTS_ROOT=

# Claude Code 실행 파일 (headless 호출용). PATH에 있으면 claude
CC_BIN=claude

# 작업 등급별 모델 — 모든 headless 호출은 작업 이름→등급(src/cc/models.py)을 거쳐 --model을 명시한다.
# 개인 CLI 기본 모델에 기대지 않는다(2026-09-28: 기본이 Fable이라 정형 추출 40여 회를 Fable로 돌린 사고).
MODEL_LIGHT=haiku
MODEL_STANDARD=sonnet
MODEL_HEAVY=opus
# Fable·Mythos 같은 최상위 모델을 headless에서 쓰려면 명시적으로 켠다(기본 false → heavy로 내림)
ALLOW_FRONTIER_HEADLESS=false

# 모델 동향 위키가 추적하는 모델(공식 문서 표기 그대로, 쉼표 구분). 목록 밖 모델(옛 모델 등)은
# 위키에 넣지 않는다 — 추적 모델에 영향을 주는 변경(대체·마이그레이션)만 그 모델 항목으로 들어온다.
MODEL_TRACK_CLAUDE=Claude Fable 5.1,Claude Opus 5.5,Claude Opus 5,Claude Sonnet 5,Claude Haiku 4.5
MODEL_TRACK_CODEX=GPT-6 Astra,GPT-6 Sol,GPT-6 Luna

# 정시 배치 사용 여부 — 남은 정시 배치는 전문가수집(주 1회)뿐이다.
# 스캔·일간보고는 대시보드에서 수동 실행만 한다(2026-10-07 사용자 결정).
SCHEDULER_ENABLED=true
